{
  "name": "reno-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted shadcn registry for multi-domain outsourcing projects (elearning, admin, ERP, CMS).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RenoAI-Labs/reno-ui.git"
  },
  "homepage": "https://ui.reno.ai.vn",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run registry:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry:build": "npm run items:sync && npm run registry:assemble && shadcn build",
    "theme:sync": "node scripts/sync-theme-vars.mjs",
    "theme:sync:check": "node scripts/sync-theme-vars.mjs --check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:render": "node scripts/check-render.mjs",
    "bench:data-grid": "node scripts/bench-data-grid.mjs",
    "check:all": "npm run theme:generate:check && npm run theme:sync:check && npm run items:sync:check && npm run registry:assemble:check && npm run demos:generate:check && npm run check:contrast && npm run check:provenance -- --check && npm run check:boundaries",
    "theme:generate": "node scripts/generate-scale.mjs",
    "theme:generate:check": "node scripts/generate-scale.mjs --check",
    "demos:generate": "node scripts/generate-demo-index.mjs",
    "demos:generate:check": "node scripts/generate-demo-index.mjs --check",
    "registry:assemble": "node scripts/build-registry-json.mjs",
    "registry:assemble:check": "node scripts/build-registry-json.mjs --check",
    "verify": "npm run check:all && npm run lint && npm run typecheck && npm test",
    "items:sync": "node scripts/sync-item-deps.mjs",
    "items:sync:check": "node scripts/sync-item-deps.mjs --check",
    "bench:tanstack": "node scripts/measure-tanstack-bundle.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-aspect-ratio": "1.1.15",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-menubar": "1.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "culori": "4.0.2",
    "date-fns": "4.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.38.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-resizable-panels": "4.12.3",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "1.1.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/culori": "4.0.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "29.1.1",
    "playwright-core": "1.62.1",
    "shadcn": "4.19.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
